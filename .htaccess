# MODX supports Friendly URLs via this .htaccess file. You must serve web
# pages via Apache with mod_rewrite to use this functionality, and you must
# change the file name from ht.access to .htaccess.
#
# Make sure RewriteBase points to the directory where you installed MODX.
# E.g., "/modx" if your installation is in a "modx" subdirectory.
#
# You may choose to make your URLs non-case-sensitive by adding a NC directive
# to your rule: RewriteRule ^(.*)$ index.php?q=$1 [L,QSA,NC]

RewriteEngine On
RewriteBase /

# ===== Закрытие от индексации: все домены, кроме боевого impulse-design.com.ua =====
# На стейдже заголовок отдаётся для всех ответов (HTML, картинки, PDF), на проде — не срабатывает.
<If "%{HTTP_HOST} !~ /^(www\.)?impulse-design\.com\.ua$/i">
    <IfModule mod_headers.c>
        Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
    </IfModule>
</If>
# ===================================================================================

RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.php
RewriteRule ^index\.php$ / [L,R=301]

# любой файл не содержащий точку и не заканчивающийся на слеш переписывается
RewriteCond %{REQUEST_URI} !(/$|\.) 
RewriteRule (.*) %{REQUEST_URI}.html [R=301,L]

RewriteCond %{REQUEST_URI} ^index\.php$
RewriteCond %{QUERY_STRING} ^(.*)&?id=1&?(.*)$ [NC]
RewriteRule ^index\.php$ /?%1%2 [L,R=301]

RewriteCond %{REQUEST_URI} ^/$
RewriteCond %{QUERY_STRING} ^(.*)&?id=1&?(.*)$ [NC]
RewriteRule ^$ /?%1%2 [R=301,L]

